{
  "name": "battery-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "echo frontend-tests",
    "test-parser": "tsx --require tsconfig-paths/register scripts/test-parser.ts",
    "test-transformer": "tsx --require tsconfig-paths/register scripts/test-transformer.ts",
    "test-import-pipeline": "tsx --require tsconfig-paths/register scripts/test-import-pipeline.ts",
    "test-importer": "tsx --require tsconfig-paths/register scripts/test-importer.ts",
    "seed:products": "tsx --require tsconfig-paths/register scripts/seed-products.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check .",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "dotenv": "^17.4.2",
    "mongodb": "^7.3.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "resend": "^6.19.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "husky": "^8.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "zod": "^4.4.3"
  }
}
